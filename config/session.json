{
  "driver": "file",
  "file": {
    "dir": "/tmp/breeze_sessions"
  },
  "cookie": {
    "name": "BREEZE_SESSION",
    "secure": false,
    "http_only": true,
    "same_site": "Lax",
    "max_age": 2592000
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6379,
    "prefix": "breeze:session:"
  }
}
